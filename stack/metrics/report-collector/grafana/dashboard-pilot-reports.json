    {
      "type": "timeseries",
      "title": "Построения по отчётам (топ-10 за период)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH top AS (\n  SELECT report FROM metrics.report_events\n  WHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report)\n  GROUP BY report ORDER BY count(*) DESC LIMIT 10\n)\nSELECT\n  $__timeGroupAlias(ts, $__interval),\n  report AS metric,\n  count(*) AS value\nFROM metrics.report_events\nWHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report)\n  AND report IN (SELECT report FROM top)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pilot-metrics-prod"
      }
    },
    {
      "type": "table",
      "title": "Сравнение с предыдущим периодом (сдвиг: $offset)",
      "description": "Текущий период - выбранный на панели времени. Предыдущий - тот же интервал, сдвинутый назад на выбранную величину.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH cur AS (\n  SELECT report,\n         count(*)                                  AS builds,\n         count(*) FILTER (WHERE status = 'error')  AS errs,\n         count(DISTINCT login)                     AS users\n  FROM metrics.report_events\n  WHERE ts >= $__timeFrom() AND ts < $__timeTo()\n    AND env IN ($env) AND report IN ($report)\n  GROUP BY report\n),\nprev AS (\n  SELECT report,\n         count(*)                                  AS builds,\n         count(*) FILTER (WHERE status = 'error')  AS errs,\n         count(DISTINCT login)                     AS users\n  FROM metrics.report_events\n  WHERE ts >= $__timeFrom()::timestamptz - INTERVAL '$offset'\n    AND ts <  $__timeTo()::timestamptz   - INTERVAL '$offset'\n    AND env IN ($env) AND report IN ($report)\n  GROUP BY report\n)\nSELECT\n  COALESCE(c.report, p.report)                  AS \"Отчёт\",\n  COALESCE(c.builds, 0)                         AS \"Построений сейчас\",\n  COALESCE(p.builds, 0)                         AS \"Построений ранее\",\n  COALESCE(c.builds, 0) - COALESCE(p.builds, 0) AS \"Δ построений\",\n  CASE WHEN COALESCE(p.builds, 0) = 0 THEN NULL\n       ELSE round(100.0 * (COALESCE(c.builds, 0) - p.builds) / p.builds, 1)\n  END                                           AS \"Прирост, %\",\n  COALESCE(c.errs, 0)                           AS \"Ошибок сейчас\",\n  COALESCE(p.errs, 0)                           AS \"Ошибок ранее\",\n  COALESCE(c.errs, 0) - COALESCE(p.errs, 0)     AS \"Δ ошибок\",\n  COALESCE(c.users, 0)                          AS \"Пользователей сейчас\",\n  COALESCE(p.users, 0)                          AS \"Пользователей ранее\"\nFROM cur c\nFULL OUTER JOIN prev p ON p.report = c.report\nORDER BY \"Построений сейчас\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Δ ошибок"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
