    {
      "type": "table",
      "title": "Сводка по отчётам за выбранный период",
      "description": "Построений - все запуски. Доля успешных считается без отменённых пользователем. Время - от DataSourceDemanded до построения последней страницы.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  report                                                                  AS \"Отчёт\",\n  count(*)                                                                AS \"Построений\",\n  count(*) FILTER (WHERE is_success)                                      AS \"Успешно\",\n  count(*) FILTER (WHERE status = 'error')                                AS \"Ошибок\",\n  count(*) FILTER (WHERE status = 'validation')                           AS \"Проверка\",\n  count(*) FILTER (WHERE status = 'cancelled')                            AS \"Отменено\",\n  round(100.0 * count(*) FILTER (WHERE is_success)\n        / NULLIF(count(*) FILTER (WHERE status <> 'cancelled'), 0), 1)     AS \"Успешных, %\",\n  round(avg(duration_ms) FILTER (WHERE is_success) / 1000.0, 1)           AS \"Среднее время, с\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms)\n        FILTER (WHERE is_success))::numeric / 1000.0, 1)                  AS \"p95, с\",\n  count(DISTINCT login)                                                   AS \"Пользователей\",\n  max(ts)                                                                 AS \"Последнее построение\"\nFROM metrics.report_events\nWHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report)\nGROUP BY report\nORDER BY \"Построений\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ошибок"
            },
