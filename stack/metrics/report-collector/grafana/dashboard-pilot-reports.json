        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  login                                         AS \"Логин\",\n  max(person)                                   AS \"Пользователь\",\n  count(*)                                      AS \"Построений\",\n  count(*) FILTER (WHERE is_success)            AS \"Успешно\",\n  count(*) FILTER (WHERE status = 'error')      AS \"Ошибок\",\n  count(DISTINCT report)                        AS \"Разных отчётов\",\n  max(ts)                                       AS \"Последнее построение\"\nFROM metrics.report_events\nWHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report)\nGROUP BY login\nORDER BY \"Построений\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
