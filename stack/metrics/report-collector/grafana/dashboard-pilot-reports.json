    {
      "type": "timeseries",
      "title": "Построения по статусам",
      "description": "success - построен, error - исключение в скрипте, validation - остановлен ReportException, cancelled - окно закрыли до конца построения.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, $__interval),\n  status AS metric,\n  count(*) AS value\nFROM metrics.report_events\nWHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report)\nGROUP BY 1, 2\nORDER BY 1"
