          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  report AS \"Отчёт\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms))::numeric / 1000.0, 1) AS \"p95, с\"\nFROM metrics.report_events\nWHERE $__timeFilter(ts) AND env IN ($env) AND report IN ($report) AND is_success AND duration_ms IS NOT NULL\nGROUP BY report\nORDER BY 2 DESC\nLIMIT 15"
