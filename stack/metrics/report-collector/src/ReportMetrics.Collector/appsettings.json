{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Metrics": "Host=localhost;Port=5432;Database=pilot_metrics;Username=metrics_writer;Password=password"
  },
  "Collector": {
    "ApiKey": "",
    "MaxBatch": 500,
    "MaxBodyBytes": 10485760,
    "RetentionDays": 30,
    "EnvMap": ":5549=stage;:5547=test;stage=stage;test=test;*=prod"
  }
}
