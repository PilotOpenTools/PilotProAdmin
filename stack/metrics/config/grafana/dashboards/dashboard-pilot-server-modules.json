          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), status AS metric, count(*) AS value\nFROM metrics.module_events WHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action'\nGROUP BY 1, 2 ORDER BY 1"
