          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  module_title || ' · ' || action AS \"Действие\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms))::numeric / 1000.0, 2) AS \"p95, с\"\nFROM metrics.module_events\nWHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action' AND is_success AND duration_ms IS NOT NULL\nGROUP BY module_title, action\nORDER BY 2 DESC\nLIMIT 15"
