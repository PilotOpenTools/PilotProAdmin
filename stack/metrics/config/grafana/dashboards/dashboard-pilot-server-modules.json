            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  env                                       AS \"Контур\",\n  server                                    AS \"Сервер\",\n  count(*)                                  AS \"Вызовов\",\n  count(*) FILTER (WHERE status = 'error')  AS \"Ошибок\",\n  count(DISTINCT module_title)              AS \"Разных модулей\",\n  max(ts)                                   AS \"Последний вызов\"\nFROM metrics.module_events\nWHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action'\nGROUP BY env, server\nORDER BY \"Вызовов\" DESC"
