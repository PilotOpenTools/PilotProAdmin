            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "WITH top AS (\n  SELECT module_title FROM metrics.module_events WHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action'\n  GROUP BY module_title ORDER BY count(*) DESC LIMIT 10\n)\nSELECT $__timeGroupAlias(ts, $__interval), module_title AS metric, count(*) AS value\nFROM metrics.module_events\nWHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action' AND module_title IN (SELECT module_title FROM top)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
