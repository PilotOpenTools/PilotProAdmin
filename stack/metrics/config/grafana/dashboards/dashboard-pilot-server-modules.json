                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Успешных, %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
