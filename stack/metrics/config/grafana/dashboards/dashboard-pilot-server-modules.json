    {
      "type": "table",
      "title": "Сводка по модулям",
      "description": "Действия, ошибки и пользователи за период. Версии - какие версии модуля присылали события.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  module_title                                                            AS \"Модуль\",\n  count(*) FILTER (WHERE kind = 'action')                                 AS \"Вызовов\",\n  count(*) FILTER (WHERE kind = 'action' AND is_success)                  AS \"Успешно\",\n  count(*) FILTER (WHERE kind = 'action' AND status = 'error')            AS \"Ошибок\",\n  count(*) FILTER (WHERE kind = 'action' AND status = 'cancelled')        AS \"Отменено\",\n  round(100.0 * count(*) FILTER (WHERE kind = 'action' AND is_success)\n        / NULLIF(count(*) FILTER (WHERE kind = 'action' AND status <> 'cancelled'), 0), 1) AS \"Успешных, %\",\n  round(avg(duration_ms) FILTER (WHERE kind = 'action' AND is_success) / 1000.0, 2)       AS \"Среднее время, с\",\n  sum(items) FILTER (WHERE kind = 'action')                               AS \"Обработано объектов\",\n  count(DISTINCT login) FILTER (WHERE kind = 'action')                    AS \"Пользователей\",\n  count(DISTINCT machine) FILTER (WHERE kind = 'load')                    AS \"Серверов\",\n  string_agg(DISTINCT module_version, ', ')                               AS \"Версии\",\n  max(ts) FILTER (WHERE kind = 'action')                                  AS \"Последнее действие\"\nFROM metrics.module_events\nWHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module)\nGROUP BY module_title\nORDER BY \"Вызовов\" DESC"
        }
      ],
      "fieldConfig": {
