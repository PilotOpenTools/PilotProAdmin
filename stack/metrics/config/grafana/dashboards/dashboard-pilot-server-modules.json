    {
      "type": "table",
      "title": "Активности серверных модулей",
      "description": "Какие активности вызывают сценарии и насколько они надёжны.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT\n  module_title                                         AS \"Модуль\",\n  action                                               AS \"Действие\",\n  count(*)                                             AS \"Раз\",\n  count(*) FILTER (WHERE status = 'error')             AS \"Ошибок\",\n  round(avg(duration_ms) FILTER (WHERE is_success) / 1000.0, 2)                                    AS \"Среднее, с\",\n  round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms))::numeric / 1000.0, 2)          AS \"p95, с\",\n  count(DISTINCT login)                                AS \"Пользователей\"\nFROM metrics.module_events\nWHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'action'\nGROUP BY module_title, action\nORDER BY \"Раз\" DESC\nLIMIT 300"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ошибок"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
