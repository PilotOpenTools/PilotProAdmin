    {
      "type": "table",
      "title": "Версии модулей на серверах",
      "description": "По событию загрузки модуля в ServerHost (старт сервера, установка, перезагрузка, откат). ",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pilot-metrics-prod"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH latest AS (\n  SELECT DISTINCT ON (module_title, machine, env) module_title, env, machine, module_version, ts\n  FROM metrics.module_events\n  WHERE $__timeFilter(ts) AND client_type = 'pilot-server' AND env IN ($env) AND module_title IN ($module) AND kind = 'load'\n  ORDER BY module_title, machine, env, ts DESC\n)\nSELECT\n  module_title          AS \"Модуль\",\n  env                   AS \"Контур\",\n  module_version        AS \"Версия\",\n  count(*)              AS \"Серверов\",\n  max(ts)               AS \"Последний запуск\"\nFROM latest\nGROUP BY module_title, env, module_version\nORDER BY \"Модуль\", \"Контур\", \"Версия\" DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
