                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Раз",
            "desc": true
          }
        ]
      },
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pilot-metrics-prod"
