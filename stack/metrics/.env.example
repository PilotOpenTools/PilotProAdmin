# Скопируйте в .env и поменяйте значения перед первым запуском: cp .env.example .env

#   cp .env.example .env

# Пароли обязательны: без них compose не запустится.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

TZ=Europe/Moscow

# Корень данных контуров: оттуда сборщики автоматизаций читают лог (только чтение).
DATA_ROOT=C:/Ascon-Docker

# --- Сборщик статистики отчётов и модулей (report-collector) ---
COLLECTOR_PORT=5310
COLLECTOR_API_KEY=

PG_HOST=postgres-prod
PG_PORT=5432
PG_DB=pilot_metrics
# Сборщики пишут под ролью metrics_writer (владелец базы pilot_metrics), Grafana читает под metrics_reader (только SELECT).
PG_USER=metrics_writer
# Пароль metrics_writer на postgres-prod (тот же, что METRICS_WRITER_PASSWORD в prod/.env).
PG_PASSWORD=
# Пароль metrics_reader (тот же, что METRICS_READER_PASSWORD в prod/.env).
METRICS_READER_PASSWORD=

# Контур по адресу сервера Pilot, который прислал клиент. Первое совпадение подстроки выигрывает.
ENV_MAP=:5549=stage;:5547=test;stage=stage;test=test;*=prod
# Срок хранения статистики (логин, ФИО, машина, текст ошибки), дней: сборщики сами удаляют старше. 0 - не удалять.
# STATS_RETENTION_DAYS=30

# Адрес, на котором слушает Prometheus (по умолчанию только этот хост). Порт без аутентификации: при другом значении закройте его брандмауэром.
# INTERNAL_BIND=127.0.0.1
