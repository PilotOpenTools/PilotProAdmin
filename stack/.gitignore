# Установочный комплект (Install), мониторинг и сборщики статистики (metrics).
# Данные и секреты сюда не попадают.

# Секреты: в git только .env.example
.env
*.env
.env.*
!.env.example

# Сборка и IDE
bin/
obj/
.vs/
*.user
TestResults/

# Файлы, которые создаёт установка рядом с комплектом
Install/images/
Install/data/
Install/.data-new/
Install/.env
Install/monitoring/
Install/modules/
Install/.data-new-run/
Install/IMAGES.txt
Install/PASSWORDS.md
# Закрытый ключ HTTPS, который кладёт администратор, и файлы правил брандмауэра, которые пишет установка
Install/certs/
Install/firewall-linux.sh
Install/firewall-windows.ps1
Install/cluster/routes.yml

# Временные каталоги установки
Install/.restore-grafana/
