# Скопируйте в .env и поменяйте пароли. install.ps1 / install.sh сделает копию сам, если .env нет.
# Комментарии пишите только отдельными строками: «KEY=значение # текст» читают по-разному (compose отбрасывает хвост, скрипты установки нет).
# Пароли-заглушки ниже install заменяет сам при первой установке на одну машину; если машин несколько, задайте их вручную и одинаково на всех.
# Значений по умолчанию у паролей в docker-compose.yml нет: PG_SUPERUSER_PASSWORD, PILOT_PG_PASSWORD, METRICS_WRITER_PASSWORD, METRICS_READER_PASSWORD, MINIO_USER, MINIO_PASSWORD, GRAFANA_ADMIN_PASSWORD и MIGRATION_API_KEY
# обязательны, без них compose не запустится (даже для сервисов, которых на этой машине нет). Установка при необходимости дописывает их сама.

# Корень всех данных на хосте: <DATA_ROOT>/prod, /test, /stage, /services, /gitlab (данные RustFS не здесь: они в томах Docker rustfs_<контур>)
DATA_ROOT=C:/Ascon-Docker
TZ=Europe/Moscow
# Имя проекта compose; от него зависят имена томов (cicd_grafana_data и др.). По умолчанию cicd.
# COMPOSE_PROJECT_NAME=cicd

# --- Какие сервисы работают на этой машине (пусто или нет строки - все, кроме GitLab) ---
# Через запятую: prod, test, stage, admin, metrics, gitlab. Удобнее задавать ключом install -Roles.
ROLES=
# На этой машине, если сервисы разнесены: IP, на котором слушают служебные порты
# (PostgreSQL, RustFS, миграция, Prometheus, Loki, агенты). Не задан или пуст: только 127.0.0.1.
# Эти порты без аутентификации: при заданном INTERNAL_BIND установка пишет готовый файл правил брандмауэра (firewall-linux.sh или
# firewall-windows.ps1) и печатает путь к нему; сама правила не применяет, примените их после просмотра.
# INTERNAL_BIND=10.0.0.1
# Имя машины в логах Loki (метка host): не задано - берётся INTERNAL_BIND, без него localhost.
# LOG_HOST=prod-1
# Адреса машин, если сервисы разнесены. Заполняются одинаково на всех машинах. Пусто - сервис на этой машине.
PROD_HOST=
TEST_HOST=
STAGE_HOST=
METRICS_HOST=
# Адрес машины с админкой, если она не на этой. Нужен только правилам брандмауэра, которые установка пишет при INTERNAL_BIND:
# они пускают на служебные порты машины из PROD_HOST, TEST_HOST, STAGE_HOST, METRICS_HOST, ADMIN_HOST и GITLAB_HOST_IP (только IP-адреса).
# ADMIN_HOST=10.0.0.5
# Только на машине admin, если контуры на других машинах. Пути к сетевым папкам их каталогов данных:
# PROD_ROOT=/mnt/cicd/prod
# TEST_ROOT=/mnt/cicd/test
# STAGE_ROOT=/mnt/cicd/stage
# Сетевых папок нет: раздел «Серверы» выключается пустым значением (и миграция работать не будет).
# SERVER_SETTINGS_ROOT=

# --- Pilot (все три контура) ---
# Свой пароль контуру можно задать префиксом: PROD_PILOT_PG_PASSWORD, TEST_PG_SUPERUSER_PASSWORD,
# STAGE_MINIO_PASSWORD и т. д. Установка из бэкапа заполняет их сама. Значение с префиксом важнее общего.
# Администратор Pilot-Server: создаётся install-скриптом на каждом сервере.
PILOT_ADMIN_LOGIN=admin
PILOT_ADMIN_PASSWORD=change-me
# PostgreSQL: суперпользователь postgres и роль pilotuser (базы Pilot).
PG_SUPERUSER_PASSWORD=postgres
PILOT_PG_PASSWORD=password
# Роли PostgreSQL для базы метрик pilot_metrics: metrics_writer (сборщики статистики пишут) и metrics_reader (Grafana только читает).
# Пустые install генерирует сам и задаёт ролям при каждом запуске; если машин несколько, задайте одинаково на всех.
METRICS_WRITER_PASSWORD=
METRICS_READER_PASSWORD=
# RustFS (S3 файлового архива)
# Имена MINIO_USER / MINIO_PASSWORD исторические (оставлены, чтобы не ломать существующие .env); значение - ключ и секрет доступа RustFS.
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
# Образ клиента rc (создание бакета). По умолчанию rustfs/rustfs:1.0.5; сам сервер берёт образ из docker-compose.yml, при смене меняйте оба.
# RUSTFS_IMAGE=rustfs/rustfs:1.0.5

# Внешние PostgreSQL и S3 выбираются независимо для каждого контура. Пример ниже для TEST, также есть PROD и STAGE.
# TEST_EXTERNAL_PG_HOST=pg.example.internal
# TEST_EXTERNAL_PG_PORT=5432
# TEST_EXTERNAL_PG_DATABASE=pilot-ice_ru
# TEST_PILOT_PG_PASSWORD=
# TEST_EXTERNAL_S3_URL=https://s3.example.internal
# TEST_EXTERNAL_S3_BUCKET=pilot-test
# TEST_S3_ACCESS_KEY=
# TEST_S3_SECRET_KEY=

# --- Админка автоматизаций ---
ADMIN_PORT=5300
# HTTPS для админки и Grafana (необязательно). Положите сертификат и ключ в PEM в папку certs рядом с install: если оба файла есть,
# установка включает HTTPS на тех же портах (ADMIN_PORT, GRAFANA_PORT), иначе всё работает по HTTP, как раньше. Сертификат должен
# подходить к имени или IP, по которым открывают админку и Grafana. Другие пути задаются так (относительные - от папки комплекта):
# TLS_CERT_FILE=certs/tls.crt
# TLS_KEY_FILE=certs/tls.key
# Адрес админки, каким его видят браузеры (например, http://10.0.0.5:5300). Из него строится адрес возврата GitLab OAuth.
# Пусто - берётся из адреса запроса.
ADMIN_PUBLIC_URL=
# Ключ установки: нужен для входа, только пока в админке не задан ни один сервер Pilot (адрес сервера тогда вводится
# на странице входа). Пусто - такой вход закрыт. При установке скриптом адреса серверов уже заданы, ключ не требуется.
ADMIN_SETUP_KEY=
# true - доверять заголовкам X-Forwarded-* от обратного прокси перед админкой; включайте, только если порт админки недоступен в обход прокси.
ADMIN_TRUST_PROXY=false
# Допустимые значения заголовка Host через «;», без порта. По умолчанию * (любой). Если сужаете, перечислите все имена, по которым
# открывают админку, и host.docker.internal (по нему CI модулей обращается к админке), иначе вход или выкладка получат 400.
# ADMIN_ALLOWED_HOSTS=10.0.0.5;admin.example.local;localhost;host.docker.internal
PILOT_TEST_URL=http://localhost:5547/pilot-ice_ru
PILOT_PROD_URL=http://localhost:5546/pilot-ice_ru
GITLAB_GROUP_URL=http://localhost:8080/automation
REPORTS_GITLAB_GROUP_URL=
MODULES_GITLAB_GROUP_URL=
SERVER_MODULES_GITLAB_GROUP_URL=
TYPES_GITLAB_PROJECT_URL=
# Заполняется для режима «Типы из GitHub». Для этого режима не добавляйте роль gitlab.
GITHUB_TYPES_REPOSITORY=
PILOT_STAGE_URL=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=
# Имя, под которым контейнеры видят хост (адреса localhost в настройках админки). По умолчанию host.docker.internal.
# LOCALHOST_ALIAS=host.docker.internal

# --- Выкладка модулей из GitLab CI ---
# Свой ключ на контур; пустые install генерирует сам (только на машине admin). Те же значения - в переменных группы GitLab:
# DEPLOY_KEY_TEST (Masked), DEPLOY_KEY_STAGE и DEPLOY_KEY_PROD (Masked и Protected).
# Старый общий MODULES_DEPLOY_KEY при установке переносится в MODULES_DEPLOY_KEY_TEST; для stage и prod он не принимается.
MODULES_DEPLOY_KEY_TEST=
MODULES_DEPLOY_KEY_STAGE=
MODULES_DEPLOY_KEY_PROD=
# Служебные учётки Pilot по контурам: под ними админка работает с Pilot (входа в Pilot у неё нет) и выкладывает модули из CI.
# Для контура на этой же машине установка подставляет администратора Pilot, которого заводит сама. Учётка из «Настроек» админки важнее.
# Пустые и не заданные в «Настройках» - контур админке недоступен.
MODULES_DEPLOY_TEST_LOGIN=
MODULES_DEPLOY_TEST_PASSWORD=
MODULES_DEPLOY_STAGE_LOGIN=
MODULES_DEPLOY_STAGE_PASSWORD=
MODULES_DEPLOY_PROD_LOGIN=
MODULES_DEPLOY_PROD_PASSWORD=

# --- Миграция (ключ общий для админки и сервиса; пусто - install сгенерирует) ---
MIGRATION_PORT=5320
MIGRATION_API_KEY=
# Кластерный Pilot-Server: база конфигурации на том же PostgreSQL (по умолчанию configurationdb). Пароль pilotuser миграция берёт
# из PILOT_PG_PASSWORD (или PROD_/TEST_/STAGE_PILOT_PG_PASSWORD) - своего пароля для миграции не нужно.
# MIGRATION_CONFIG_DATABASE=configurationdb

# --- Сборщик статистики отчётов ---
COLLECTOR_PORT=5310
# Ключ приёма статистики: пусто - приём без ключа. При первой установке на одну машину install генерирует его сам;
# тот же ключ нужен в настройках клиентских и серверных модулей.
COLLECTOR_API_KEY=
ENV_MAP=:5549=stage;:5547=test;stage=stage;test=test;*=prod
# Срок хранения статистики (логин, ФИО, машина, текст ошибки), дней: сборщики сами удаляют старше. 0 - не удалять.
# STATS_RETENTION_DAYS=30

# --- Мониторинг ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
PROMETHEUS_PORT=9090

# --- GitLab (роль gitlab: install -WithGitLab или -Roles gitlab) ---
# IP этой машины в сети (не localhost), иначе GitLab недоступен с других компьютеров.
GITLAB_HOST_IP=localhost
GITLAB_HTTP_PORT=8080
GITLAB_SSH_PORT=2224
GITLAB_ROOT_PASSWORD=change-me-please
# DNS для заданий CI (через запятую), если Docker отдаёт контейнерам негодные адреса (например, Proxifier на машине): 8.8.8.8,1.1.1.1.
# Применяется только при регистрации runner'а установщиком (нет gitlab/runner-config/config.toml).
RUNNER_DNS=
