# Скопируйте в node.env. На каждой машине задайте свои имя, адрес и локальные пути.
PILOT_SERVER_IMAGE=
CLUSTER_NODE_NAME=pilot-node-a
CLUSTER_NODE_BIND=10.0.0.11
CLUSTER_NODE_PORT=5545
CLUSTER_NODE_ROOT=/var/lib/pilot-cluster/test/node-a
CLUSTER_SHARED_ROOT=/mnt/pilot-cluster/test

# Эти значения одинаковы на всех узлах. Пароль поместите в файл с правами 600.
CLUSTER_PG_HOST=pg.internal
CLUSTER_PG_PORT=5432
CLUSTER_PG_USER=pilotuser
CLUSTER_PG_PASSWORD=
CLUSTER_CONFIG_DATABASE=configurationdb

# Только для команды initialize.sh на первой машине.
CLUSTER_SEED_ROOT=/var/lib/pilot-cluster/test/seed
CLUSTER_REDIS_CONNECTION=
CLUSTER_PILOT_ADMIN=
CLUSTER_PILOT_PASSWORD=

# Только для gateway.yml, в отдельном gateway.env.
CLUSTER_GATEWAY_BIND=10.0.0.10
CLUSTER_GATEWAY_PORT=5545
