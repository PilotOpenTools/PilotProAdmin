# Скопируйте в .env и задайте свои значения: без них контур не запустится.
# Пароли меняет shared/rotate-contour-secrets.ps1 -Env prod (он же пишет их сюда, в Postgres, RustFS и settings.xml Pilot).
DATA_ROOT=C:/Ascon-Docker
PG_SUPERUSER_PASSWORD=
PILOT_PG_PASSWORD=
# Роли базы метрик pilot_metrics: metrics_writer (сборщики пишут), metrics_reader (Grafana читает). Те же значения - в metrics/.env
# (PG_PASSWORD = METRICS_WRITER_PASSWORD, METRICS_READER_PASSWORD).
METRICS_WRITER_PASSWORD=
METRICS_READER_PASSWORD=
# Имена MINIO_USER / MINIO_PASSWORD исторические; значение - ключ и секрет доступа RustFS.
MINIO_USER=minioadmin
MINIO_PASSWORD=
# Служебная S3-учётка Pilot и сервиса миграции (доступ только к бакету pilot-ice-ru).
MINIO_PILOT_USER=pilot
MINIO_PILOT_SECRET=
