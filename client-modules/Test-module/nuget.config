<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов модуля. cicd - реестр пакетов GitLab проекта Pilot.ClientSdk (пакет Pilot.ClientSdk и другие пакеты Pilot.*).
  Адрес ниже - образец: подставьте адрес вашего GitLab (gitlab.example.local) и числовой id проекта Pilot.ClientSdk
  (PROJECT_ID: Settings / General / Project ID). Источник по http:// требует allowInsecureConnections="true"; для https:// этот атрибут уберите.
  CI входит в него токеном job (шаг в build_module). На своей машине один раз добавьте вход личным токеном GitLab (read_api):
    dotnet nuget update source cicd -u <логин GitLab> -p <токен> -configfile %AppData%\NuGet\NuGet.Config
  (если источника cicd там ещё нет - dotnet nuget add source <адрес ниже> -n cicd -u … -p …). Подробнее - README Pilot.ClientSdk, 4.2 «Источник GitLab на своей машине».
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cicd" value="http://gitlab.example.local/api/v4/projects/PROJECT_ID/packages/nuget/index.json" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="cicd">
      <package pattern="Pilot.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
