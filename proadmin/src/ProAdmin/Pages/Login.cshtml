@page
@model LoginModel
@{
    ViewData["Title"] = "Вход";
    ViewData["Bare"] = true;
}
<div class="auth">
    <div class="brand auth-brand">PilotProAdmin</div>
    <div class="auth-card">
        <header class="auth-head">
            <h1>Вход в админку</h1>
            @if (Model.GitLabBaseUrl is not null)
            {
                <p class="muted">Используйте учётную запись GitLab на @Model.GitLabBaseUrl.</p>
            }
        </header>

        @if (Model.Error is not null)
        {
            <div class="alert alert-error" role="alert">@Model.Error</div>
        }

        @if (Model.GitLabBaseUrl is null)
        {
            <p class="alert alert-warn">Для входа администратор должен настроить адрес группы GitLab.</p>
        }
        else
        {
            @if (Model.GitLabOAuthEnabled)
            {
                <form method="post" asp-page-handler="GitLab">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <button type="submit" class="btn btn-primary btn-block">Войти через GitLab</button>
                </form>
            }
            <details class="login-token" open="@(!Model.GitLabOAuthEnabled)">
                <summary class="small">Войти с Personal Access Token</summary>
                <form method="post" asp-page-handler="Token" class="form">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <label class="field">
                        <span>Токен (scope <code>api</code>)</span>
                        <input asp-for="AccessToken" type="password" placeholder="glpat-…" autocomplete="off" required />
                    </label>
                    <button type="submit" class="btn btn-block">Войти</button>
                </form>
            </details>
        }
    </div>
</div>
