@model ProAdmin.Pages.AppPageModel
@* Страница с записью только для администратора админки: остальным - только чтение. *@
@if (!Model.IsAdmin)
{
    <div class="alert alert-info">
        <b>Только просмотр.</b> Изменять общие настройки, раздел «Миграция» и настройки серверов может только
        @(Model.UsesServiceAccounts ? "администратор GitLab" : "сессия с входом администратором Pilot контура «Прод»").
    </div>
}
