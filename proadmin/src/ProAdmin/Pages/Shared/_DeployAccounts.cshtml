@model List<ProAdmin.Settings.DeployAccountInput>
<h2>Служебные учётные записи Pilot для выкладки из GitLab CI</h2>
<p class="muted small">Пустой пароль сохраняет прежнюю учётную запись. Для замены введите логин и пароль администратора сервера.
    Модули и отчёты выкладываются входом в базу: если в базе нет пользователя с этим логином, админка создаст его
    с тем же паролем, правами администратора базы и должностью в подразделении «PilotProAdmin» (займёт одну лицензию).</p>
<div class="deploy-accounts">
    @for (var i = 0; i < Model.Count; i++)
    {
        var contour = ProAdmin.Settings.DeployAccounts.Contours[i];
        var title = contour switch { "test" => "Тест", "stage" => "Стейдж", "prod" => "Прод", _ => contour };
        <fieldset class="deploy-account">
            <legend><span class="env-dot env-@contour" aria-hidden="true"></span>@title</legend>
            <label class="field">
                <span>Логин</span>
                <input asp-for="@Model[i].Login" autocomplete="off" />
            </label>
            <label class="field">
                <span>Пароль</span>
                <input asp-for="@Model[i].Password" type="password" autocomplete="new-password" />
            </label>
        </fieldset>
    }
</div>
