@model List<ProAdmin.Settings.DeployAccountInput>
<h2>Служебные учётные записи Pilot для выкладки из GitLab CI</h2>
<p>Пустой пароль сохраняет прежнюю учётную запись. Для замены введите логин и пароль администратора сервера.</p>
@for (var i = 0; i < Model.Count; i++)
{
    <fieldset>
        <legend>@ProAdmin.Settings.DeployAccounts.Contours[i]</legend>
        <label asp-for="@Model[i].Login">Логин</label><input asp-for="@Model[i].Login" autocomplete="off" />
        <label asp-for="@Model[i].Password">Пароль</label><input asp-for="@Model[i].Password" type="password" autocomplete="new-password" />
        <label><input asp-for="@Model[i].Disable" /> Отключить служебную учётную запись</label>
    </fieldset>
}
