# Скопируйте в .env и при необходимости поправьте.

# Порт веб-админки на хосте: http://localhost:5300
ADMIN_PORT=5300

# Во что превращать localhost внутри контейнера (Pilot на :5546/:5547/:5549, GitLab на :8080 хоста).
LOCALHOST_ALIAS=host.docker.internal

# Адрес, по которому пользователи открывают админку (например, http://192.0.2.10:5300 или https://admin.example.local).
# От него строится адрес возврата OAuth: {ADMIN_PUBLIC_URL}/GitLab/Callback. Пусто - берётся из адреса запроса.
# Для https cookie входа всегда Secure.
ADMIN_PUBLIC_URL=
# Ключ установки: нужен для входа, только пока в админке не задан ни один сервер Pilot (адрес сервера тогда вводится
# на странице входа). Пусто - такой вход закрыт. При установке скриптом адреса серверов уже заданы, ключ не требуется.
ADMIN_SETUP_KEY=
# true - доверять заголовкам X-Forwarded-For/Proto/Host. Включайте, только если админка стоит за своим обратным прокси
# (иначе любой клиент подделает свой адрес и обойдёт ограничение частоты неверных входов).
ADMIN_TRUST_PROXY=false
# Допустимые значения заголовка Host через «;», без порта. По умолчанию * (любой). Если сужаете, перечислите все имена, по которым
# открывают админку, и host.docker.internal (по нему CI модулей обращается к админке), иначе вход или выкладка получат 400.
# ADMIN_ALLOWED_HOSTS=192.0.2.10;admin.example.local;localhost;host.docker.internal

# Вход через GitLab (OAuth). Создайте приложение в GitLab:
#   Admin Area / Applications / New application
#   Redirect URI: {ADMIN_PUBLIC_URL}/GitLab/Callback (например, http://localhost:5300/GitLab/Callback), Confidential, scope: api
# Если не задано - пользователи подключают GitLab по Personal Access Token.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Нужен только если адрес возврата отличается от {ADMIN_PUBLIC_URL}/GitLab/Callback.
GITLAB_OAUTH_REDIRECT_URI=

# Серверы Pilot и группа GitLab - общие для всех пользователей.
# Применяются при первом запуске (пока нет data/settings.json), потом правятся на странице «Настройки».
PILOT_TEST_URL=http://localhost:5547/pilot-ice_ru
PILOT_PROD_URL=http://localhost:5546/pilot-ice_ru
GITLAB_GROUP_URL=http://localhost:8080/automation
# Группа GitLab с отчётами (вкладка «Отчёты»). Пусто - вкладка выключена до настройки.
REPORTS_GITLAB_GROUP_URL=http://localhost:8080/reports
# Группа GitLab с клиентскими модулями (вкладка «Модули») и сервер стейджа (ветки release/X.Y.Z).
MODULES_GITLAB_GROUP_URL=http://localhost:8080/client-modules
PILOT_STAGE_URL=http://localhost:5549/pilot-ice_ru
# Группа GitLab с серверными модулями - только для таблицы «Активные работы». Пусто - таблица скрыта.
SERVER_MODULES_GITLAB_GROUP_URL=http://localhost:8080/server-extensions

# Сервис миграции данных (migration/). Один ключ на админку и сервис, он обязателен: без него compose не запустится.
MIGRATION_API_KEY=

# Выкладка модулей из GitLab CI. Ключи раздельные по контурам; значение = переменная группы модулей в GitLab:
#   MODULES_DEPLOY_KEY_TEST  = DEPLOY_KEY_TEST  (Masked)
#   MODULES_DEPLOY_KEY_STAGE = DEPLOY_KEY_STAGE (Masked и Protected)
#   MODULES_DEPLOY_KEY_PROD  = DEPLOY_KEY_PROD  (Masked и Protected)
# Задайте длинные случайные значения (например, openssl rand -hex 32). Пустой ключ - выкладка на этот контур выключена.
# Кроме ключа запрос обязан нести job-токен $CI_JOB_TOKEN: админка проверяет его в GitLab (ветка, коммит, проект берутся оттуда).
MODULES_DEPLOY_KEY_TEST=
MODULES_DEPLOY_KEY_STAGE=
MODULES_DEPLOY_KEY_PROD=
# Прежний общий ключ MODULES_DEPLOY_KEY: принимается только для test и только если MODULES_DEPLOY_KEY_TEST пуст.
# Для stage и prod не принимается никогда; после перехода на ключи по контурам удалите его.
MODULES_DEPLOY_KEY=
# Служебные учётки Pilot для выкладки из CI по контурам
MODULES_DEPLOY_TEST_LOGIN=
MODULES_DEPLOY_TEST_PASSWORD=
MODULES_DEPLOY_STAGE_LOGIN=
MODULES_DEPLOY_STAGE_PASSWORD=
MODULES_DEPLOY_PROD_LOGIN=
MODULES_DEPLOY_PROD_PASSWORD=
# Репозиторий типов по умолчанию (дальше - «Настройки»)
TYPES_GITLAB_PROJECT_URL=

# --- Сервис миграции данных (migration/) ---
MIGRATION_PORT=5320
# Адрес, на котором порт миграции открыт на хосте (по умолчанию только на этой машине).
MIGRATION_BIND=127.0.0.1
# Корни данных контуров: те же каталоги используются и для раздела «Серверы» (server-settings) админки.
PROD_ROOT=C:/Ascon-Docker/prod
TEST_ROOT=C:/Ascon-Docker/test
PROD_PILOT_ADMIN=admin
PROD_PILOT_PASSWORD=
TEST_PILOT_ADMIN=admin
TEST_PILOT_PASSWORD=
STAGE_ROOT=C:/Ascon-Docker/stage
STAGE_PILOT_ADMIN=admin
STAGE_PILOT_PASSWORD=
# Пароль PostgreSQL (роль pilotuser) каждого контура - нужен, если Pilot-Server контура работает кластером (в его настройках
# пароль зашифрован). У монолита пароль берётся из settings.xml, а это значение запасное. Пусто - кластерный контур не подключится.
PROD_PILOT_PG_PASSWORD=
TEST_PILOT_PG_PASSWORD=
STAGE_PILOT_PG_PASSWORD=
# База конфигурации кластера Pilot-Server (по умолчанию configurationdb)
# MIGRATION_CONFIG_DATABASE=configurationdb
# Папка с присланными файловыми базами (.dbp) для импорта: подпапка на базу, монтируется только на чтение
IMPORT_ROOT=C:/Ascon-Docker/import
# Папка выгрузок базы в файлы (.dbp + тела файлов): папка на выгрузку, монтируется на запись
EXPORT_ROOT=C:/Ascon-Docker/export
