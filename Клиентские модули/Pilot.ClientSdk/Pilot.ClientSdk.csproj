<Project Sdk="Microsoft.NET.Sdk">

	<!-- Основные настройки сборки -->
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<UseWPF>true</UseWPF>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<Version>2.1.1</Version>
		<AssemblyName>113Pilot.ClientSdk.ext2</AssemblyName>
		<RootNamespace>Pilot.ClientSdk</RootNamespace>
		<OutputType>Library</OutputType>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<!-- Сборка на Linux-раннере GitLab -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Версия модуля - только <Version>: AssemblyVersion/FileVersion генерирует SDK. Остальные атрибуты - в AssemblyInfo.cs. -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyTrademarkAttribute>false</GenerateAssemblyTrademarkAttribute>
		<GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<!--
		NuGet-пакет для других модулей: dotnet pack / пакет Pilot.ClientSdk в реестре GitLab (см. README, «NuGet-пакет»).
		Сборка лежит в ref/net48 - только для компиляции: в bin и zip модуля она не копируется
		(в клиенте Pilot она уже загружена модулем Pilot.ClientSdk, вторая копия дала бы конфликт типов).
	-->
	<PropertyGroup>
		<PackageId>Pilot.ClientSdk</PackageId>
		<Authors>CICD</Authors>
		<Description>Общий модуль для клиентских модулей Pilot: статистика использования (Grafana), проверка загрузки модулей и общие методы SDK. Только для компиляции: в клиенте сборку загружает модуль Pilot.ClientSdk.</Description>
		<PackageTags>pilot;ascon;cicd</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackReferenceAssembly</TargetsForTfmSpecificContentInPackage>
		<!-- NU5128/NU5131: в пакете нет lib/ - так и задумано, сборка только для компиляции -->
		<NoWarn>$(NoWarn);NU5128;NU5131</NoWarn>
	</PropertyGroup>

	<Target Name="PackReferenceAssembly">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).xml" PackagePath="ref/$(TargetFramework)" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DebugType>full</DebugType>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\ASCON\Pilot-BIM\Ascon.Pilot.PilotBIM.exe</StartProgram>
	</PropertyGroup>

	<!-- Pilot SDK: в клиенте уже загружен, в поставку не попадает -->
	<ItemGroup>
		<PackageReference Include="Ascon.Pilot.SDK" Version="26.13.0">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" PrivateAssets="all" />
		<PackageReference Include="Humanizer.Core.ru" Version="2.14.1" PrivateAssets="all" />
		<PackageReference Include="SharpVectors" Version="1.8.6" PrivateAssets="all" />
	</ItemGroup>

	<!--
		Общие сторонние библиотеки для других модулей (эксперимент 2.1.0). В zip этого модуля лежит только Humanizer.dll
		(см. CreateReleaseZip); другие модули ссылаются на неё только для компиляции (ExcludeAssets=runtime). В клиенте Pilot
		недостающую dll модуля ищут обработчики AssemblyResolve всех уже загруженных модулей - в том числе этого, по его папке.
		DocumentFormat.OpenXml и SharpVectors в коде модуля не используются и в zip не входят.
		PrivateAssets=all - зависимости не попадают в NuGet-пакет Pilot.ClientSdk (в пакете их нет).
	-->

	<ItemGroup>
		<Reference Include="System.ComponentModel.Composition" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Runtime.Serialization" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Pilot.ClientSdk.config.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="tests\**" />
		<None Remove="tests\**" />
		<Compile Remove="ci-template\**" />
		<None Remove="ci-template\**" />
	</ItemGroup>

	<!-- Release: архив для загрузки модуля на сервер Pilot (без pdb/xml и без сборок, которые уже есть в клиенте) -->
	<Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<_ZipStage>$(MSBuildProjectDirectory)\obj\zip-stage\</_ZipStage>
			<_ZipPath>$(MSBuildProjectDirectory)\bin\$(AssemblyName)-$(Version).zip</_ZipPath>
		</PropertyGroup>
		<ItemGroup>
			<_ZipFiles Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)Pilot.ClientSdk.config.json;$(TargetDir)Humanizer.dll" />
		</ItemGroup>
		<RemoveDir Directories="$(_ZipStage)" />
		<Copy SourceFiles="@(_ZipFiles)" DestinationFolder="$(_ZipStage)" />
		<Delete Files="$(_ZipPath)" />
		<ZipDirectory SourceDirectory="$(_ZipStage)" DestinationFile="$(_ZipPath)" />
		<Message Importance="high" Text="Модуль для загрузки в Pilot: $(_ZipPath)" />
	</Target>

	<!-- Debug: копия в папку разработки клиента, Pilot-BIM подхватит модуль без загрузки на сервер -->
	<PropertyGroup>
		<DevExtensionDir>$(LocalAppData)\ASCON\Pilot-BIM\Development\$(AssemblyName)</DevExtensionDir>
	</PropertyGroup>
	<Target Name="CopyToDevelopmentDirectory" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' AND '$(OS)' == 'Windows_NT' AND '$(CopyToPilot)' != 'false'">
		<ItemGroup>
			<_DevFiles Include="$(TargetDir)$(AssemblyName).*;$(TargetDir)Pilot.ClientSdk.config.json;$(TargetDir)Humanizer.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_DevFiles)" DestinationFolder="$(DevExtensionDir)" />
	</Target>

</Project>
