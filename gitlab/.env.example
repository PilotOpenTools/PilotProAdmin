# Скопируйте в .env и заполните перед первым запуском.

# IP этой машины в сети (не localhost): из него собирается external_url, по нему GitLab открывают с других машин.
GITLAB_HOST_IP=192.168.1.100

# Порт веб-интерфейса и порт git по SSH (не 22, если на машине уже работает SSH-сервер).
GITLAB_HTTP_PORT=8080
GITLAB_SSH_PORT=2224

# Образ закреплён в docker-compose.yml (GITLAB_IMAGE). Обновлять только по пути обновления GitLab, со свежей копией.

# Внутреннее имя контейнера, менять не обязательно.
GITLAB_HOSTNAME=gitlab.local

# Начальный пароль root, не короче 8 символов. Действует только при первом запуске.
GITLAB_ROOT_PASSWORD=
